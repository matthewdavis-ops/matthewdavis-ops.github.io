        "answer_options": [
          "Yes",
          "No"
        ],
        "requires_evidence": true
      },
      {
        "id": "abi_supports_venous",
        "label": "ABI/TBI documented and consistent with venous (ABI > 0.9; ABI ≤ 0.9 indicates co-existing LEAD — reconsider etiology)",
        "answer_options": [
          "Yes",
          "No"
        ],
        "requires_evidence": true
      },
      {
        "id": "compression_ordered",
        "label": "Compression therapy ordered & completed (multilayer / stockings > 20 mmHg / pneumatic)",
        "answer_options": [
          "Yes",
          "No"
        ],
        "requires_evidence": true
      },
      {
        "id": "compression_appropriate_for_abi",
        "label": "Compression level appropriate for documented ABI (full 30–42 mmHg if > 0.8 · reduced 23–30 mmHg if < 0.8 · CONTRAINDICATED if < 0.6)",
        "answer_options": [
          "Yes",
          "No",
          "N/A"
        ],
        "requires_evidence": true
      },
      {
        "id": "edema_managed",
        "label": "Edema / venous hypertension / lymphedema addressed (lymphedema requires specialist)",
        "answer_options": [
          "Yes",
          "No",
          "N/A"
        ],
        "requires_evidence": true
      },
      {
        "id": "ceap_vcss",
        "label": "CEAP classification + VCSS documented for severity & reassessment",
        "answer_options": [
          "Yes",
          "No"
        ],
        "requires_evidence": true
      },
      {
        "id": "wound_characteristics_venous",
        "label": "Wound characteristics documented (lower leg/gaiter area, edema, hemosiderin/hyperpigmentation, irregular border)",
        "answer_options": [
          "Yes",
          "No"
        ],
        "requires_evidence": true
      },
      {
        "id": "failed_4wk_swc",
        "label": "Failure to improve after ≥ 4 weeks standard therapy documented, citing specific failed interventions (CTP gate)",
        "answer_options": [
          "Yes",
          "No",
          "N/A"
        ],
        "requires_evidence": true
      },
      {
        "id": "dx_over_3mo",
        "label": "Venous stasis diagnosis documented > 3 months prior (CTP eligibility)",
        "answer_options": [
          "Yes",
          "No",
          "N/A"
        ],
        "requires_evidence": true
      }
    ]
  },
