{
  "ARTERIAL_ULCER": {
    "key": "ARTERIAL_ULCER",
    "label": "Arterial Insufficiency Ulcer",
    "category": "perfusion_ulcer",
    "criteria": [
      {
        "id": "arterial_perfusion_documented",
        "label": "Arterial perfusion assessed & documented consistent with LEAD (ABI ≤ 0.9 / TBI < 0.64 / TcPO2 < 40 mmHg; if ABI > 1.3 = calcified, use TBI/toe pressure)",
        "answer_options": [
          "Yes",
          "No"
        ],
        "requires_evidence": true
      },
      {
        "id": "wound_characteristics_arterial",
        "label": "Wound characteristics documented consistent with arterial (distal/foot/toes, well-defined border, pale or necrotic base, painful)",
        "answer_options": [
          "Yes",
          "No"
        ],
        "requires_evidence": true
      },
      {
        "id": "compression_avoided",
        "label": "Compression NOT applied / appropriately withheld given arterial status (contraindicated at ABI < 0.6)",
        "answer_options": [
          "Yes",
          "No",
          "N/A"
        ],
        "requires_evidence": true
      },
      {
        "id": "vascular_referral",
        "label": "Referral for vascular evaluation / revascularization documented when indicated (P&P: refer at ABI < 0.5)",
        "answer_options": [
          "Yes",
          "No",
          "N/A"
        ],
        "requires_evidence": true
      },
      {
        "id": "history_prior_treatment",
        "label": "History of current wound & prior treatments documented",
        "answer_options": [
          "Yes",
          "No"
        ],
        "requires_evidence": true
      },
      {
        "id": "tobacco_status",
        "label": "Tobacco use documented + cessation counseling (primary LEAD risk factor)",
        "answer_options": [
          "Yes",
          "No",
          "N/A"
        ],
        "requires_evidence": true
      },
      {
        "id": "infection_addressed",
        "label": "Infection assessed and treated if present",
        "answer_options": [
          "Yes",
          "No",
          "N/A"
        ],
        "requires_evidence": true
      }
    ]
  },
  "VENOUS_ULCER": {
    "key": "VENOUS_ULCER",
    "label": "Venous Insufficiency Ulcer",
    "category": "perfusion_ulcer",
    "criteria": [
      {
        "id": "venous_reflux_studies",
