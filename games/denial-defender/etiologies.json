          "No"
        ],
        "requires_evidence": true
      },
      {
        "id": "infection_addressed",
        "label": "Infection treated; osteomyelitis addressed if present",
        "answer_options": [
          "Yes",
          "No",
          "N/A"
        ],
        "requires_evidence": true
