{
  "DFU": {
    "key": "DFU",
    "label": "Diabetic Foot Ulcer",
    "category": "wound_care",
    "criteria": [
      {
        "id": "diabetes",
        "label": "Patient must have diabetes",
        "answer_options": [
          "Yes",
          "No"
        ],
        "requires_evidence": true
      },
      {
        "id": "wagner_3_or_higher",
        "label": "Wound/Ulcer of the lower extremity, classified as Wagner Grade III or higher (Deep wound with either Positive Radiology Results or Positive Culture)",
        "answer_options": [
          "Yes",
          "No"
        ],
        "requires_evidence": true
      },
      {
        "id": "30_days_swc",
        "label": "Patient must have 30 days of standard wound care documented",
        "answer_options": [
          "Yes",
          "No"
        ],
        "requires_evidence": true
      },
      {
        "id": "no_measurable_healing",
        "label": "Documentation supporting no measurable signs of healing during the 30 days of standard wound care (Wound measurements, Drainage, Odor, Pain)",
        "answer_options": [
          "Yes",
          "No"
        ],
        "requires_evidence": true
      },
      {
        "id": "documented_debridements",
        "label": "Documented debridements",
        "answer_options": [
          "Yes",
          "No"
        ],
        "requires_evidence": true
      },
      {
        "id": "documented_offloading",
        "label": "Documented off-loading",
        "answer_options": [
          "Yes",
          "No"
        ],
        "requires_evidence": true
      },
      {
        "id": "documented_glucose_control",
        "label": "Documented glucose control",
        "answer_options": [
          "Yes",
          "No"
        ],
        "requires_evidence": true
      },
      {
        "id": "documented_vascular_assessment",
        "label": "Documented vascular assessment (ex: ABI, TCOM, SnapshotNIR, Pulses)",
        "answer_options": [
          "Yes",
          "No"
        ],
        "requires_evidence": true
      },
      {
        "id": "documented_nutritional_assessment",
        "label": "Documented nutritional assessment (ex: Albumin, Pre-Albumin, Nestle Assessment)",
        "answer_options": [
          "Yes",
          "No"
        ],
        "requires_evidence": true
      },
      {
        "id": "documented_moist_dressings",
        "label": "Documented moist dressings (NOTE: This does not include gauze dressings)",
        "answer_options": [
          "Yes",
          "No"
        ],
        "requires_evidence": true
      },
      {
        "id": "documented_infection_treatment",
        "label": "Documented treatment of infection",
        "answer_options": [
          "Yes",
          "No"
        ],
        "requires_evidence": true
      }
    ]
  },
